# Supabase project URL and anon (public) key.
# Found in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the email-confirmation redirect link (Supabase Auth →
# emailRedirectTo). Set this to your deployed origin, e.g.
# https://alburhan.app in production, http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never used by the app code and never sent to the browser — only add this
# to a local .env.local (never committed) if a future module needs
# service-role/admin-only server operations.
# SUPABASE_SERVICE_ROLE_KEY=
